extends SceneTree
var failures:=0
func check(ok:bool,label:String)->void:
	if not ok:
		failures+=1
		printerr("FAIL "+label)
func _initialize()->void:call_deferred("run")
func offer(scene)->void:
	# State fixture only: normal-play test proves earned offers separately.
	scene.session.actions=3
	scene.session.phase="busy"
	scene.session.finish_refill()
func run()->void:
	var scene=load("res://main.tscn").instantiate()
	root.add_child(scene)
	preload("res://tests/enter_adventure.gd").enter(scene)
	await process_frame
	offer(scene)
	var card:Vector2=scene.UI.reward_rect(0,3).get_center()
	scene.release(card,-1)
	check(scene.session.relics.is_empty(),"old release cannot choose new offer")
	scene.press(card,-1)
	scene.move_pointer(Vector2.ZERO,-1)
	scene.release(card,-1)
	check(scene.session.phase=="reward" and scene.session.relics.is_empty(),"outside cancellation keeps reward")
	scene.press(card,-1)
	scene._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	scene.release(card,-1)
	check(scene.session.phase=="reward","focus loss does not consume reward")
	var event:=InputEventScreenTouch.new()
	event.index=0;event.pressed=true;event.position=card;scene._input(event)
	var extra:=InputEventScreenTouch.new()
	extra.index=1;extra.pressed=true;extra.position=scene.UI.reward_rect(1,3).get_center();scene._input(extra)
	extra.pressed=false;scene._input(extra)
	check(scene.session.relics.is_empty(),"extra finger cannot commit modal")
	event.pressed=false;event.canceled=true;scene._input(event)
	check(scene.session.phase=="reward","system cancellation keeps offer")
	scene.press(scene.SKILL.get_center(),-1)
	check(not scene.session.skill_mode,"modal blocks skill")
	scene.press(scene.board_to_screen(scene.session.panels[0].pos),-1)
	# Board lies under modal; any card down has to be cancelled before this check.
	scene.cancel_input()
	check(scene.session.selection.is_empty(),"modal never creates board preview")
	scene.press(card,-1);scene.release(card,-1);scene.release(card,-1)
	check(scene.session.relics==["pigment"] and scene.session.rewards_taken==1,"single atomic choice")
	var point:Vector2=scene.board_to_screen(scene.session.panels[0].pos)
	scene.release(point,-1)
	check(scene.session.actions==3,"card release not reused for board")
	scene.session.ash_reserved=true;scene.session.charge_required=2
	scene.session.actions=6;scene.session.phase="busy";scene.session.finish_refill()
	scene.press(scene.RESET.get_center(),-1)
	check(scene.session.phase=="ready" and scene.session.relics.is_empty() and scene.session.reward_round==0,"reset exits modal and clears relics")
	check(scene.session.charge==3 and scene.session.charge_required==3 and not scene.session.ash_reserved and scene.session.actions==0,"reset clears recharge and stats")
	scene.release(card,-1)
	check(scene.session.relics.is_empty() and scene.session.actions==0,"old modal release after reset ignored")
	# Summary fixture isolates input routing; normal-play coverage earns action nine.
	scene.session.actions=9;scene.session.phase="busy";scene.session.finish_refill()
	var continue_point:Vector2=scene.UI.SUMMARY_CONTINUE.get_center()
	check(scene.session.phase=="summary","ninth completed action opens summary")
	scene.release(continue_point,-1)
	check(scene.session.phase=="summary","old release cannot dismiss new summary")
	scene.press(continue_point,-1)
	scene.move_pointer(Vector2.ZERO,-1)
	scene.move_pointer(continue_point,-1)
	scene.release(continue_point,-1)
	check(scene.session.phase=="summary" and scene.modal_pointer==-99,"outside and reenter cannot dismiss cancelled summary press")
	scene.press(continue_point,-1)
	scene._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	scene.release(continue_point,-1)
	check(scene.session.phase=="summary" and scene.modal_pointer==-99,"focus loss cancels summary press without dismissal")
	event.position=continue_point;event.pressed=true;event.canceled=false;scene._input(event)
	extra.position=continue_point;extra.pressed=true;scene._input(extra)
	extra.pressed=false;scene._input(extra)
	check(scene.session.phase=="summary" and scene.modal_pointer==0,"extra finger cannot dismiss summary")
	event.pressed=false;event.canceled=true;scene._input(event)
	event.canceled=false;scene._input(event)
	check(scene.session.phase=="summary" and scene.modal_pointer==-99,"system cancellation and stale release preserve summary")
	scene.press(continue_point,-1);scene.release(continue_point,-1)
	check(scene.session.phase=="ready" and scene.session.actions==9,"fresh summary press and release continue without action")
	scene.release(continue_point,-1);scene.release(point,-1)
	check(scene.session.phase=="ready" and scene.session.actions==9 and scene.session.selection.is_empty(),"duplicate summary release cannot execute board action")
	# Reset during an armed summary press invalidates its pending release.
	scene.session.summary_shown=false;scene.session.phase="busy";scene.session.finish_refill()
	scene.press(continue_point,-1)
	scene.press(scene.RESET.get_center(),-1)
	scene.release(continue_point,-1)
	check(scene.session.phase=="ready" and scene.session.actions==0 and not scene.session.summary_shown and scene.modal_pointer==-99,"reset invalidates armed summary release")
	scene.queue_free();await process_frame;await create_timer(0.25).timeout
	print("REWARD_INPUT failures=",failures)
	quit(1 if failures else 0)
